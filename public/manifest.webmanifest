{
  "id": "/",
  "name": "PolTok — Election Night Command Center",
  "short_name": "PolTok",
  "description": "Live election results, maps, markets and news.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#05070d",
  "theme_color": "#05070d",
  "categories": ["news", "politics"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Live results", "short_name": "Live", "url": "/live", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Results map", "short_name": "Map", "url": "/map", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "News", "short_name": "News", "url": "/news", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Australia", "short_name": "AU", "url": "/au", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
